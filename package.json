{
  "name": "nederlandse-rp-bot",
  "version": "0.1.0",
  "description": "Een Discord RP-bot voor de Nederlandse rolspel-gemeenschap",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun test"
  },
  "keywords": [
    "discord",
    "bot",
    "roleplay",
    "rp",
    "nederlands",
    "bun",
    "typescript"
  ],
  "author": "HologramSteve",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/bun": "latest",
    "@biomejs/biome": "^2.5.8"
  },
  "dependencies": {
    "discord.js": "^14.15.3"
  }
}
